# Servidor
PORT=3001
NODE_ENV=development

# Base de datos (en Docker Compose, DB_HOST se sobreescribe a "postgres")
DB_HOST=localhost
DB_PORT=5432
DB_USER=yaya
DB_PASSWORD=yaya
DB_NAME=yaya

# Redis (en Docker Compose, REDIS_HOST se sobreescribe a "redis")
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (definir un secreto real antes de producción)
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=7d
